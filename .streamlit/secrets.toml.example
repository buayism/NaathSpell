# .streamlit/secrets.toml
# ───────────────────────
# This file is NOT committed to GitHub.
# On Streamlit Cloud, paste these values into:
#   App Settings → Secrets
#
# To create a GitHub token:
#   1. Go to github.com → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   2. Create a token with "Contents" read+write permission scoped to your repo
#   3. Copy the token below

[github]
token = "ghp_YOUR_GITHUB_TOKEN_HERE"
repo  = "YOUR_USERNAME/naathspell"
branch = "main"
